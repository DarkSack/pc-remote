{
  "Agent": {
    "WebSocket": {
      "Port": 47820,
      "BindAddress": "0.0.0.0"
    },
    "Discovery": {
      "MdnsServiceType": "_pcremote._tcp",
      "UdpFallbackPort": 47821
    },
    "Storage": {
      "DatabasePath": "%LOCALAPPDATA%/PcRemote/agent.db",
      "CertificatePath": "%LOCALAPPDATA%/PcRemote/cert.pfx"
    },
    "Pairing": {
      "CodeTtlSeconds": 120,
      "MaxAttempts": 3,
      "LockoutSeconds": 300
    },
    "Session": {
      "TokenTtlHours": 24,
      "PingIntervalSeconds": 15
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/PcRemote/logs/agent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
