{
  "Agent": {
    "WebSocket": {
      "Port": 47820,
      "BindAddress": "0.0.0.0"
    },
    "Discovery": {
      "MdnsServiceType": "_sackdesk._tcp"
    },
    "Storage": {
      "DatabasePath": "%LOCALAPPDATA%/SackDesk/agent.db",
      "CertificatePath": "%LOCALAPPDATA%/SackDesk/cert.pfx"
    },
    "Pairing": {
      "CodeTtlSeconds": 120,
      "MaxAttempts": 3,
      "LockoutSeconds": 300
    },
    "Session": {
      "PingIntervalSeconds": 15
    },
    "Panel": {
      "Enabled": true,
      "Port": 47810
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/SackDesk/logs/agent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
