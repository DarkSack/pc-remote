<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained PcRemote.exe: no .NET install needed on the PC, no
  appsettings.json or DLLs next to it (settings have embedded defaults).

    dotnet publish src/PcRemote.Agent -p:PublishProfile=win-x64

  Output: agent/publish/PcRemote.exe. Also used by build-exe.ps1 and CI.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native libraries (SQLite, libsodium) inside the exe too; extracted on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WinForms does not support trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <!-- Only the exe in the output: no .pdb of the referenced projects. -->
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
