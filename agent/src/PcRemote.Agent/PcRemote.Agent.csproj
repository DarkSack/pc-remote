<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <RootNamespace>PcRemote.Agent</RootNamespace>
    <AssemblyName>PcRemote.Agent</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosting comes through PcRemote.Core's Microsoft.AspNetCore.App reference. -->
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcRemote.Core\PcRemote.Core.csproj" />
    <!-- All modules referenced so their DLLs copy to bin/ next to the exe. -->
    <ProjectReference Include="..\PcRemote.Modules.System\PcRemote.Modules.System.csproj" />
    <ProjectReference Include="..\PcRemote.Modules.SystemInfo\PcRemote.Modules.SystemInfo.csproj" />
    <ProjectReference Include="..\PcRemote.Modules.Input\PcRemote.Modules.Input.csproj" />
    <ProjectReference Include="..\PcRemote.Modules.Clipboard\PcRemote.Modules.Clipboard.csproj" />
    <ProjectReference Include="..\PcRemote.Modules.Applications\PcRemote.Modules.Applications.csproj" />
    <ProjectReference Include="..\PcRemote.Modules.Processes\PcRemote.Modules.Processes.csproj" />
    <ProjectReference Include="..\PcRemote.Modules.Windows\PcRemote.Modules.Windows.csproj" />
    <ProjectReference Include="..\PcRemote.Modules.Media\PcRemote.Modules.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
