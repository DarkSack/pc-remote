<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PcRemote.Core</RootNamespace>
  </PropertyGroup>

  <!-- Hosting, DI, logging and configuration come with Microsoft.AspNetCore.App
       (FrameworkReference below), so they are not listed as packages. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- Maintained fork of Makaretu.Dns.Multicast (same Makaretu.Dns namespace).
         The original stopped at 0.27.0 and dragged in NETStandard.Library 1.6.1
         with vulnerable System.Net.Http / System.Text.RegularExpressions 4.3.0. -->
    <PackageReference Include="Makaretu.Dns.Multicast.New" Version="0.38.0" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Panel\panel.html" />
  </ItemGroup>
</Project>
